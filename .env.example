# Create a bot with @BotFather on Telegram and put its token here
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Optional. Anyone can subscribe by sending /start to the bot in Telegram -
# this is only a convenience so the bot owner is auto-subscribed on first
# run without having to /start their own bot. Leave empty otherwise.
TELEGRAM_CHAT_ID=

# How often to poll, in minutes (a random +/- jitter is added so requests
# don't fire at a perfectly predictable interval)
POLL_INTERVAL_MINUTES=5
POLL_JITTER_MINUTES=1

# Only notify about tickets within this many days from today
LOOKAHEAD_DAYS=60

# Keep false: headless Chrome is blocked by the site's Cloudflare/Turnstile
# checks. On a server without a display, run the bot inside xvfb-run (the
# systemd unit in deploy/ already does).
HEADLESS=false

# System-installed Google Chrome - what reliably passes Turnstile. Set to
# "chromium" to use patchright's bundled Chromium instead
# (python -m patchright install chromium).
PLAYWRIGHT_CHANNEL=chrome
